# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# ทุก key ในไฟล์นี้ต้องตรงกับ field ใน app/config.py

# ---- แอป ----
# ใช้เซ็น session cookie — เปลี่ยนค่านี้แล้วทุกคนจะถูก logout
# สร้างใหม่ด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# URL ที่ผู้ใช้เข้าถึงแอป — ถ้าเป็น https:// คุกกี้จะถูกตั้ง Secure อัตโนมัติ
APP_BASE_URL=http://localhost:8000

# ระดับ log ของแอป — DEBUG / INFO / WARNING
# ต่ำกว่า INFO จะไม่เห็นข้อความยืนยันตอนสร้างบัญชีแรก
LOG_LEVEL=INFO

# timezone ของ *เครื่อง CPAP* ไม่ใช่ของ server
# ไฟล์ .BYS เก็บเวลาแบบ local wall-clock ไม่มี timezone ค่านี้คือตัวที่ใช้แปลงเป็น UTC
DEVICE_TZ=Asia/Bangkok

# ---- บัญชีแรก ----
#
# ตั้งสองบรรทัดนี้ = แอปสร้างบัญชีผู้ดูแลให้ตอนบูตครั้งแรกเลย เปิดเว็บแล้วล็อกอินได้ทันที
# ไม่ต้องเปิดหน้า /setup ไม่ต้องหา setup token
#
# ถ้าเว้นว่างไว้ แอปจะสุ่ม setup token แล้วให้ไปสร้างบัญชีเองที่ /setup
# (token อยู่ใน log ตอนสตาร์ต และในไฟล์ ./data/setup-token)
#
# ⚠️ ใช้ "ตอน initialise เท่านั้น" — อ่านเฉพาะตอนที่ยังไม่มีบัญชีในระบบเลย
#    แก้ INIT_PASSWORD ทีหลังแล้วรีสตาร์ต "รหัสจะไม่เปลี่ยน"
#    เปลี่ยนรหัสด้วย:  docker compose exec app python -m app.cli passwd <ชื่อ>
#    (ถ้าค่าในไฟล์ไม่ตรงกับบัญชีจริงแล้ว แอปจะเตือนใน log ให้)
#
# 💡 แนะนำให้ "เก็บสองบรรทัดนี้ไว้" ไม่ต้องลบ — ถ้าวันหนึ่ง volume ของฐานข้อมูลหาย
#    จนไม่เหลือบัญชี แอปจะสร้างบัญชีเดิมกลับมาให้เอง แทนที่จะเปิด /setup โล่ง ๆ
#    ทิ้งไว้ให้ใครก็ได้ที่เข้าถึงพอร์ตมายึดเป็นผู้ดูแลระบบ
#
# รหัสผ่านต้องยาวอย่างน้อย 8 ตัวอักษร ไม่งั้นแอปจะไม่สร้างบัญชีให้และตกไปใช้ token แทน
INIT_USERNAME=
INIT_PASSWORD=

# ที่เก็บไฟล์ของ instance นี้: ฐานข้อมูล SQLite และ setup token
DATA_DIR=./data

# ---- ฐานข้อมูล relational (users / devices / ingest ledger) ----
# SQLite เป็นค่าเริ่มต้น ย้ายไป Postgres/MariaDB ได้โดยแก้บรรทัดนี้บรรทัดเดียว เช่น
#   postgresql+psycopg://user:pass@db:5432/pap
#   mysql+pymysql://user:pass@db:3306/pap
DATABASE_URL=sqlite:///./data/app.db

# ---- InfluxDB ----
# ชี้ไปที่ตัวใน docker compose (profile local-influx) หรือ Influx ตัวนอก/cloud ก็ได้
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=change-me-influx-token
INFLUX_ORG=pap
INFLUX_BUCKET=pap

# ค่าเริ่มต้นของ InfluxDB ตัวใน compose (ใช้เฉพาะตอน bootstrap ครั้งแรก)
# ถ้าใช้ Influx ตัวนอก ค่าพวกนี้ไม่มีผล
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change-me-at-least-8-chars

# ---- ขีดจำกัดการอัปโหลด ----
MAX_UPLOAD_MB=64
MAX_FILES_PER_REQUEST=200
# กัน zip bomb: ขนาดรวมสูงสุดหลังแตกไฟล์ และจำนวน entry สูงสุดใน zip
MAX_ZIP_UNCOMPRESSED_MB=256
MAX_ZIP_ENTRIES=5000

# ---- Grafana ----
GRAFANA_URL=http://localhost:3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
